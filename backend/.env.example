# --- LLM Primary (Google AI Studio Gemini) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# --- LLM Fallback (OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ATHINA <your_email@gmail.com>

# --- Google Workspace (Gmail + Calendar via OAuth2) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend-domain.onrender.com/api/google/oauth/callback
# Optional fallback for unscoped internal integrations only; authenticated users use their own OAuth tokens.
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# --- TTS (ElevenLabs) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=lxYfHSkYm1EzQzGhdbfc
ELEVENLABS_MODEL_ID=eleven_monolingual_v1

# --- Server ---
NODE_ENV=development
FRONTEND_ORIGIN=https://your-frontend.pages.dev
PUBLIC_APP_URL=https://your-frontend.pages.dev
PORT=3000
REQUEST_TIMEOUT_MS=9000